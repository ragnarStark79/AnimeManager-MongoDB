# ==============================================================================
# AnimeManager — Environment Variable Template (.env.example)
#
# IMPORTANT: This file contains SAFE PLACEHOLDERS only.
# Copy this file to .env (or respective app .env files) for local development.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (apps/web/.env or root .env)
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ------------------------------------------------------------------------------
# In local development with Vite dev proxy (recommended):
VITE_API_BASE_URL=/api/v1
# In standalone production or direct cross-origin setups:
# VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_TITLE=AnimeManager

# Local development authentication:
# In development mode, the frontend automatically obtains a fresh development
# session for the seeded local owner (00000000-0000-0000-0000-000000000001) from
# GET /api/v1/auth/dev-session. No manual token configuration is required in .env.

# Optional: if frontend needs direct read-only Supabase storage access
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# BACKEND API CONFIGURATION (apps/api/.env or root .env)
# These values remain STRICTLY SERVER-SIDE.
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Local development authentication (true by default in development; rejected in production)
ENABLE_DEV_AUTH=true

# ------------------------------------------------------------------------------
# AUTHENTICATION CONFIGURATION (Phase 04 Decoupled JWT)
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying owner JWT tokens (HS256).
# Must be at least 16 characters. Never use the development fallback in production.
JWT_SECRET=your-jwt-secret-min-16-chars-long!

# ------------------------------------------------------------------------------
# MONGODB CONFIGURATION (Primary Application Database)
# ------------------------------------------------------------------------------
# Hosted MongoDB Atlas cluster (production / cloud deployment):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=animemanager
#
# Local development MongoDB instance (optional local fallback):
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB_NAME=animemanager

# ------------------------------------------------------------------------------
# LEGACY SUPABASE / POSTGRESQL (Retained during transition)
# ------------------------------------------------------------------------------
# PostgreSQL Database Connection
# Local development database (verified with verify-db script):
# DATABASE_URL=postgresql://localhost:5432/animemanager_test
#
# Hosted Supabase PostgreSQL database:
# Direct connection (port 5432):
# DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
#
# Supavisor Connection Pooler (Dual-stack IPv4/IPv6 support):
# Port 5432 (Session mode - recommended for long-running Node.js pg.Pool):
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# Port 6543 (Transaction mode - recommended for serverless/edge environments):
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
#
# Dedicated Supabase DB URL variable (higher priority than DATABASE_URL if set):
# SUPABASE_DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
#
# Remote DB test opt-in guard:
# ALLOW_REMOTE_DB_TESTS=true
SUPABASE_URL=https://your-project.supabase.co
# Service Role key has administrative privileges (bypasses RLS) - NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Legacy Supabase JWT secret (backward-compatible fallback if JWT_SECRET is unset):
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Metadata Provider Integration (MyAnimeList catalogue via Tenrai API)
# The public Jikan API (api.jikan.moe) was discontinued on Oct 1, 2026.
# Tenrai provides verified Jikan v4-compatible REST endpoints for the MyAnimeList catalog.
METADATA_API_BASE_URL=https://api.tenrai.org/v1
# Legacy fallback (compatible with self-hosted Jikan v4 instances):
# JIKAN_BASE_URL=http://localhost:8080/v4
REQUEST_TIMEOUT_MS=10000

# Rate Limiting Configuration
IMPORT_RATE_LIMIT_WINDOW_MS=60000
IMPORT_RATE_LIMIT_MAX=20

# Cover Upload Storage Constraints (5 MB default)
COVER_MAX_BYTES=5242880
